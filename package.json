{
  "name": "asset",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "runtime:prepare": "npm ci --ignore-scripts --prefix runtime-profiles/react19-vite6",
    "runner:prepare": "node scripts/runner/prepare.cjs",
    "runner:verify": "node scripts/runner/verify-local.cjs",
    "runtime:prepare:expanded": "npm ci --ignore-scripts --prefix runtime-profiles/react18-vite5-v1 && npm ci --ignore-scripts --prefix runtime-profiles/react19-vite8-v1 && npm ci --ignore-scripts --prefix runtime-profiles/react18-vite4-three-v1",
    "runtime:prepare:common": "npm ci --ignore-scripts --prefix runtime-profiles/react18-vite6-common-v1 && npm ci --ignore-scripts --prefix runtime-profiles/react19-vite7-common-v1",
    "deploy:cloudflare": "node scripts/cloudflare-deploy.mjs",
    "db:backup": "node scripts/db/backup.mjs",
    "db:backup:verify": "node scripts/db/verify-backup.mjs",
    "deploy:versions": "npx wrangler versions list --json",
    "deploy:deployments": "npx wrangler deployments list",
    "deploy:rollback": "node scripts/cloudflare-rollback.mjs",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "smoke:production:public": "node scripts/production-smoke-public.mjs",
    "db:recovery:preflight": "node scripts/db/recovery-preflight.mjs",
    "launch:smoke-fixture": "node scripts/launch/materialization-smoke-fixture.mjs"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/view": "6.43.11",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.2",
    "codemirror": "6.0.2",
    "esbuild": "^0.25.12",
    "firebase": "^12.19.0",
    "isomorphic-dompurify": "^2.16.0",
    "jose": "6.2.12",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^0.468.0",
    "parse5": "8.0.0",
    "pg": "8.23.0",
    "postcss": "^8.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-refresh": "0.17.0",
    "semver": "7.7.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "7.7.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  }
}

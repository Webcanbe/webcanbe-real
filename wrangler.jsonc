{
  "name": "webcanbe-real",
  "compatibility_date": "2026-09-18",
  "main": "./worker/index.js",
  "secrets": {
    "required": [
      "GOOGLE_OAUTH_CLIENT_ID",
      "GOOGLE_OAUTH_CLIENT_SECRET"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/__webcanbe/auth/*"]
  }
}

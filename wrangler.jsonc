{
  "name": "webcanbe-real",
  "compatibility_date": "2026-09-19",
  "main": "./worker/google-verification.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/",
      "/policy",
      "/policy/",
      "/terms",
      "/terms/",
      "/robots.txt",
      "/sitemap.xml"
    ]
  }
}

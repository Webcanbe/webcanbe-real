{
  "name": "webcanbe-real",
  "compatibility_date": "2026-09-18",
  "main": "./worker/index.js",
  "keep_vars": true,
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "136713667501",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_API_RATE_LIMITER",
      "namespace_id": "136713667502",
      "simple": {
        "limit": 180,
        "period": 60
      }
    },
    {
      "name": "PRIVATE_API_RATE_LIMITER",
      "namespace_id": "136713667503",
      "simple": {
        "limit": 180,
        "period": 60
      }
    },
    {
      "name": "BIGPERSON_RATE_LIMITER",
      "namespace_id": "136713667504",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "WEBCANBE_BIGPERSON_GOOGLE_EMAIL": "sihumin196@gmail.com",
    "WEBCANBE_CONTROL_MODE": "enabled",
    "WEBCANBE_PRODUCT_MUTATIONS": "enabled"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7f537011fc1a4303aac7aff9601a1699"
    }
  ],
  "secrets": {
    "required": [
      "GOOGLE_OAUTH_CLIENT_ID",
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "WEBCANBE_BIGPERSON_FACTOR_PEPPER",
      "WEBCANBE_BIGPERSON_BOOTSTRAP_FACTOR_SALT",
      "WEBCANBE_BIGPERSON_BOOTSTRAP_FACTOR_DIGEST"
    ]
  },
  "define": {
    "__filename": "\"/worker/index.js\"",
    "__dirname": "\"/worker\""
  },
  "browser": {
    "binding": "BROWSER"
  },
  "ai": {
    "binding": "AI"
  }
}
